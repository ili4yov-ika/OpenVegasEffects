#!/usr/bin/make -f
# Debian build rules for OpenVegas Effects

export DH_VERBOSE = 1

# The build tree goes where every build does:
# build/<OS>_<compiler>-<arch>-<configuration>.
%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=build/Linux_GCC-x64-Release-Package

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_test:
	# The regression suites live in tests/ as a project of their own.
	true
