<?xml version="1.0" encoding="UTF-8"?>
<!--
    Audio Meters panel - bottom dock, hidden by default (objName
    "AudioMetersPanel", root "AudioMetersWidget").

    Static-layout capture of src/ui/AudioMetersPanel.cpp (constructor).
    The two meters are painted LED columns in custom widgets (InputLevels /
    OutputLevels). Hold Peaks preference is read from QSettings at runtime.

    Nothing is wired: the form is not added to CMakeLists.txt / the .pro and
    is not loaded anywhere. See ui/panels/README.md for the seam.
-->
<ui version="4.0">
 <class>openvegas::ui::AudioMetersPanel</class>
 <widget class="QDockWidget" name="AudioMetersPanel">
  <property name="windowTitle">
   <string>Meters</string>
  </property>
  <widget class="QWidget" name="AudioMetersWidget">
   <layout class="QVBoxLayout" name="metersLayout">
    <property name="spacing"><number>3</number></property>
    <property name="leftMargin"><number>4</number></property>
    <property name="topMargin"><number>4</number></property>
    <property name="rightMargin"><number>4</number></property>
    <property name="bottomMargin"><number>4</number></property>
    <item>
     <layout class="QHBoxLayout" name="options">
      <item>
       <widget class="QCheckBox" name="AudioMetersHoldPeaks">
        <property name="text"><string>Hold Peaks</string></property>
        <property name="checked"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QToolButton" name="toolButtonResetPeaks">
        <property name="text"><string>Reset</string></property>
        <property name="toolTip"><string>Reset peak hold levels</string></property>
        <property name="autoRaise"><bool>true</bool></property>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <layout class="QHBoxLayout" name="meters">
      <item>
       <layout class="QVBoxLayout" name="inputColumn">
        <item>
         <widget class="QLabel" name="inputLabel">
          <property name="text"><string>Input Levels</string></property>
          <property name="alignment">
           <set>Qt::AlignCenter</set>
          </property>
         </widget>
        </item>
        <item>
         <!-- LED column, painted by AudioMeterDisplay. -->
         <widget class="QWidget" name="InputLevels">
          <property name="minimumSize">
           <size><width>32</width><height>90</height></size>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QVBoxLayout" name="outputColumn">
        <item>
         <widget class="QLabel" name="outputLabel">
          <property name="text"><string>Output Levels</string></property>
          <property name="alignment">
           <set>Qt::AlignCenter</set>
          </property>
         </widget>
        </item>
        <item>
         <!-- LED column, painted by AudioMeterDisplay. -->
         <widget class="QWidget" name="OutputLevels">
          <property name="minimumSize">
           <size><width>32</width><height>90</height></size>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </item>
   </layout>
  </widget>
 </widget>
 <resources/>
 <connections/>
</ui>