<?xml version="1.0" encoding="UTF-8"?>
<!--
    Track panel - right dock, tab group Effects | Controls | Layout | Track
    (objName "TrackPanel").

    Static-layout capture of src/ui/TrackPanel.cpp (constructor + buildToolbar).
    Object names are the reference ones; rows and the blend combos are rebuilt
    at runtime from the composition.

    Nothing is wired: the form is not added to CMakeLists.txt / the .pro and
    is not loaded anywhere. See ui/panels/README.md for the seam.
-->
<ui version="4.0">
 <class>openvegas::ui::TrackPanel</class>
 <widget class="QDockWidget" name="TrackPanel">
  <property name="windowTitle">
   <string>Track</string>
  </property>
  <widget class="QWidget" name="trackContentWidget">
   <layout class="QVBoxLayout" name="trackLayout">
    <property name="spacing"><number>2</number></property>
