<?xml version="1.0" encoding="UTF-8"?>
<!--
    Start panel - bottom dock, tabbed with Timeline (objName "StartPanel",
    root "StartPanelWidget", sidebar "ProjectSideBarWidget").

    Static-layout capture of src/ui/StartPanel.cpp (constructor + the
    makeActionButton helper). Object names are the reference ones; recent
    projects list is rebuilt at runtime.

    Nothing is wired: the form is not added to CMakeLists.txt / the .pro and
    is not loaded anywhere. See ui/panels/README.md for the seam.
-->
<ui version="4.0">
