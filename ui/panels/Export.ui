<?xml version="1.0" encoding="UTF-8"?>
<!--
    Export panel - spec copy in ui/panels/, stylised like the other panel
    windows: the root is a QDockWidget so the frame carries the dock buttons,
    "undock to a full window" (DockWidgetFloatable) and "close"
    (DockWidgetClosable). The inner widget keeps the Reference object names.

    NOT WIRED: this form is not added to CMakeLists.txt / the .pro and is not
    loaded anywhere. The production .ui used by ExportPanel via Ui::ExportPanel
    setupUi() already exists at ui/ExportPanel.ui (it IS wired); both must stay
    in sync on object names: lineEditExportDirectory, toolButtonExportDirectory,
    comboBoxPreset, pushButtonExportFrame, pushButtonExportContents,
    plainTextProgress. In the live code the shell around the form is the
    ExportPanel widget itself (objectName "export-panel", zero-margin wrapper).

    Static-layout capture of src/ui/ExportPanel.cpp (constructor) + the
    existing ui/ExportPanel.ui.
-->
<ui version="4.0">
 <class>openvegas::ui::ExportPanel</class>
 <widget class="QDockWidget" name="export-panel">
  <property name="windowTitle">
   <string>Export</string>
  </property>
  <property name="features">
   <set>QDockWidget::DockWidgetClosable|QDockWidget::DockWidgetFloatable|QDockWidget::DockWidgetMovable</set>
  </property>
  <widget class="QWidget" name="ExportPanel">
   <layout class="QVBoxLayout" name="rootLayout">
    <property name="spacing"><number>6</number></property>
    <property name="leftMargin"><number>4</number></property>
    <property name="topMargin"><number>4</number></property>
    <property name="rightMargin"><number>4</number></property>
    <property name="bottomMargin"><number>4</number></property>
    <item>
     <layout class="QFormLayout" name="formLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="labelDirectory">
        <property name="text"><string>Directory</string></property>
       </widget>
      </item>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="directoryRow">
        <item>
         <widget class="QLineEdit" name="lineEditExportDirectory">
          <property name="placeholderText"><string>Export directory</string></property>
         </widget>
        </item>
        <item>
         <widget class="QToolButton" name="toolButtonExportDirectory">
          <property name="text"><string>...</string></property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="labelPreset">
        <property name="text"><string>Preset</string></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="comboBoxPreset">
        <item><property name="text"><string notr="true">H.264 (.mp4)</string></property></item>
        <item><property name="text"><string notr="true">PNG (.png)</string></property></item>
        <item><property name="text"><string notr="true">JPEG (.jpg)</string></property></item>
        <item><property name="text"><string notr="true">OpenEXR (.exr)</string></property></item>
        <item><property name="text"><string notr="true">ProRes (.mov)</string></property></item>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <layout class="QHBoxLayout" name="buttonRow">
      <item>
       <widget class="QPushButton" name="pushButtonExportFrame">
        <property name="text"><string>Export Frame</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="pushButtonExportContents">
        <property name="text"><string>Export Contents</string></property>
       </widget>
      </item>
      <item>
       <spacer name="buttonSpacer">
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
        <property name="sizeHint" stdset="0">
         <size><width>40</width><height>20</height></size>
        </property>
       </spacer>
      </item>
     </layout>
    </item>
    <item>
     <widget class="QPlainTextEdit" name="plainTextProgress">
      <property name="readOnly"><bool>true</bool></property>
     </widget>
    </item>
   </layout>
  </widget>
 </widget>
 <resources/>
 <connections/>
</ui>