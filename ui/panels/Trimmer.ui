<?xml version="1.0" encoding="UTF-8"?>
<!--
    Trimmer panel - the "Trimmer" tab of the central stackedWidgetScreens
    (objectName "trimmer-panel"; root widget, not a dock).

    Static-layout capture of src/ui/TrimmerPanel.cpp (constructor). Object
    names are the reference ones; the strip (TrimmerWidget "trimmer-frame")
    is painted and the source list is populated at runtime.

    Nothing is wired: the form is not added to CMakeLists.txt / the .pro and
    is not loaded anywhere. See ui/panels/README.md for the seam.
-->
<ui version="4.0">
 <class>openvegas::ui::TrimmerPanel</class>
 <widget class="QWidget" name="trimmer-panel">
  <property name="windowTitle">
   <string>Trimmer</string>
  </property>
  <property name="acceptDrops"><bool>true</bool></property>
  <layout class="QVBoxLayout" name="trimmerLayout">
   <property name="spacing"><number>2</number></property>
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <item>
    <widget class="QWidget" name="trimmer-toolbar-top">
     <layout class="QHBoxLayout" name="topBar">
      <property name="spacing"><number>6</number></property>
