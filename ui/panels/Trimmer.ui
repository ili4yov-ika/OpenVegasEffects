       </spacer>
      </item>
      <item>
       <widget class="QToolButton" name="trimmerInsert">
        <property name="text"><string>Insert</string></property>
        <property name="toolTip"><string>Insert trimmer clip (B)</string></property>
        <property name="autoRaise"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QToolButton" name="trimmerOverlay">
        <property name="text"><string>Overlay</string></property>
        <property name="toolTip"><string>Overlay trimmer clip (N)</string></property>
        <property name="autoRaise"><bool>true</bool></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <!-- Clip strip; painted by TrimmerWidget::paintEvent. -->
    <widget class="QFrame" name="trimmer-in-out">
     <layout class="QVBoxLayout" name="inOutLayout">
      <property name="spacing"><number>0</number></property>
