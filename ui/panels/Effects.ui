<?xml version="1.0" encoding="UTF-8"?>
<!--
    Effects panel - right dock, tab group Effects | Controls (objName
    "effectsPanel").

    Static-layout capture of src/ui/EffectsPanel.cpp (constructor + QTreeWidget
    columns). Object names are the reference ones; effect rows are rebuilt at
    runtime from the plugin browser.

    Nothing is wired: the form is not added to CMakeLists.txt / the .pro and
    is not loaded anywhere. See ui/panels/README.md for the seam.
-->
<ui version="4.0">
 <class>openvegas::ui::EffectsPanel</class>
 <widget class="QDockWidget" name="effectsPanel">
  <property name="windowTitle">
   <string>Effects</string>
  </property>
  <widget class="QWidget" name="effectsContentWidget">
   <layout class="QVBoxLayout" name="effectsLayout">
    <property name="spacing"><number>4</number></property>
    <property name="leftMargin"><number>4</number></property>
    <property name="topMargin"><number>4</number></property>
    <property name="rightMargin"><number>4</number></property>
    <property name="bottomMargin"><number>4</number></property>
    <item>
     <widget class="QLineEdit" name="effects-panel-search">
      <property name="placeholderText"><string>Search in Effects</string></property>
      <property name="clearButtonEnabled"><bool>true</bool></property>
     </widget>
    </item>
    <item>
     <layout class="QHBoxLayout" name="showAllRow">
      <property name="spacing"><number>4</number></property>
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>
      <item>
       <widget class="QToolButton" name="effects-panel-show-all">
        <property name="text"><string>Show All</string></property>
        <property name="autoRaise"><bool>true</bool></property>
        <property name="toolButtonStyle">
         <enum>Qt::ToolButtonTextOnly</enum>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="showAllSpacer">
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size><width>10</width><height>20</height></size>
        </property>
       </spacer>
      </item>
     </layout>
    </item>
    <item>
     <!-- No column headers; col0 = effect name (stretch), col1 = star (fixed). -->
     <widget class="QTreeWidget" name="effectsTree">
      <property name="columnCount"><number>2</number></property>
      <property name="headerHidden"><bool>true</bool></property>
      <property name="rootIsDecorated"><bool>true</bool></property>
     </widget>
    </item>
    <item>
     <!-- "N item(s)" counter, rebuilt by updateItemCount(). -->
     <widget class="QLabel" name="effects-panel-count">
      <property name="text">
       <string notr="true"></string>
      </property>
      <property name="alignment">
       <set>Qt::AlignRight|Qt::AlignVCenter</set>
      </property>
     </widget>
    </item>
   </layout>
  </widget>
 </widget>
 <resources/>
 <connections/>
</ui>