    },
    {
      "label": "CMake: Clean (MSVC)",
      "type": "shell",
      "command": "if exist \"${workspaceFolder}\\build\\Windows_MSVC-x64\" rmdir /s /q \"${workspaceFolder}\\build\\Windows_MSVC-x64\" & if exist \"${workspaceFolder}\\build\\Windows_MSVC-x64-Release\" rmdir /s /q \"${workspaceFolder}\\build\\Windows_MSVC-x64-Release\" & echo Cleaned.",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        },
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Run OpenVegas Effects (MSVC Debug)",
      "type": "shell",
      "command": "${workspaceFolder}/build/Windows_MSVC-x64/OpenVegasEffects.exe",
      "options": {
        "cwd": "${workspaceFolder}/build/Windows_MSVC-x64",
        "env": {
          "PATH": "C:/Qt/6.9.3/msvc2022_64/bin;${env:PATH}",
          "QT_PLUGIN_PATH": "C:/Qt/6.9.3/msvc2022_64/plugins"
        }
      },
      "dependsOn": [
        "CMake: Build (MSVC Debug)"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
